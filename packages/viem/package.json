    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md"
  ],
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "viem": "^2.0.0"
  },
  "scripts": {
    "test": "node test.mjs"
  },
  "repository": "github:artemmartyhin/balq",
  "homepage": "https://github.com/artemmartyhin/balq",
  "license": "MIT OR Apache-2.0",
  "keywords": [
    "ethereum",
    "viem",
    "transport",
