# systemd unit for `balq index`: watches the contracts in balq.toml, fills
# their history back to the deploy, then follows the node. Install:
#   sudo cp deploy/balq.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now balq
# /var/lib/balq/balq.toml:
#   rpc = "http://127.0.0.1:8545"
#   data = "/var/lib/balq/balq.redb"
#   watch = ["0x…"]
#   layout = "/var/lib/balq/Contract.json"   # optional: field names in the log

[Unit]
Description=balq — verified contract storage archive
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=balq
Group=balq
WorkingDirectory=/var/lib/balq
ExecStart=/usr/local/bin/balq --config /var/lib/balq/balq.toml index --poll 4 --serve
Restart=always
RestartSec=5
# --serve: `balq get/diff/history/status --data /var/lib/balq/balq.redb` work
# while the service holds the file (localhost only).
# Downtime costs nothing: on restart the loop continues from the archive
# head and reads the blocks it missed from the node.
StartLimitIntervalSec=0
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/balq
PrivateTmp=true

[Install]
WantedBy=multi-user.target
