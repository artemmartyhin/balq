{
  "name": "@balq/node",
  "version": "0.2.2",
  "description": "Local, verified archive of contract storage built from EIP-7928 BALs — Node.js bindings",
  "main": "lib.js",
  "types": "lib.d.ts",
  "license": "MIT OR Apache-2.0",
  "files": [
    "lib.js",
    "lib.d.ts",
    "index.js",
    "index.d.ts"
  ],
  "napi": {
    "binaryName": "bal-node",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin"
    ]
  },
  "engines": {
    "node": ">= 18"
  },
  "scripts": {
    "build": "napi build --release --platform",
    "build:debug": "napi build --platform",
    "test": "node test/check-loader.mjs && node test/smoke.mjs",
    "prepack": "node test/check-loader.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3"
  },
  "optionalDependencies": {
    "@balq/node-win32-x64-msvc": "0.2.2",
    "@balq/node-linux-x64-gnu": "0.2.2",
    "@balq/node-linux-arm64-gnu": "0.2.2",
    "@balq/node-darwin-x64": "0.2.2",
    "@balq/node-darwin-arm64": "0.2.2"
  }
}
